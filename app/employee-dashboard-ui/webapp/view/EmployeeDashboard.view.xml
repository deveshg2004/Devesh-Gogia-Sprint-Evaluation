<mvc:View
    controllerName="asset.lifecycle.employeedashboardui.controller.EmployeeDashboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:viz="sap.viz.ui5.controls">

    <Page
        id="employeeDashboardPage"
        title="Employee Dashboard"
        class="employeeDashboardPage">

        <content>

            <VBox
                id="employeeDashboardVBox"
                class="employeeDashboardContent">

                <!-- Welcome Section -->
                <Panel
                    id="welcomePanel"
                    class="dashboardHero"
                    expandable="false">

                    <content>

                        <HBox
                            id="welcomeRow"
                            alignItems="Center"
                            justifyContent="SpaceBetween"
                            wrap="Wrap">

                            <HBox
                                id="welcomeIdentity"
                                alignItems="Center">

                                <Avatar
                                    id="employeeAvatar"
                                    initials="RS"
                                    displaySize="M"
                                    class="employeeAvatar"/>

                                <VBox
                                    id="welcomeText"
                                    class="sapUiSmallMarginBegin">

                                    <Title
                                        id="welcomeTitle"
                                        text="Welcome back, Rahul!"
                                        level="H2"/>

                                    <Text
                                        id="welcomeSubtitle"
                                        text="Here is a quick overview of your IT assets and requests."/>

                                </VBox>

                            </HBox>

                            <ObjectStatus
                                id="employeeStatus"
                                text="Active Employee"
                                state="Success"
                                icon="sap-icon://accept"/>

                        </HBox>

                    </content>
                </Panel>


                <!-- Quick Access -->
                <Title
                    id="quickAccessTitle"
                    text="Quick Access"
                    level="H2"
                    class="sectionTitle"/>

                <HBox
                    id="employeeNavigationBar"
                    class="quickAccessRow"
                    wrap="Wrap"
                    justifyContent="Start">

                    <Button
                        id="profileBtn"
                        text="My Profile"
                        icon="sap-icon://employee"
                        press="onMyProfile"
                        type="Emphasized"
                        class="quickAccessButton"/>

                    <Button
                        id="assetsBtn"
                        text="My Assets"
                        icon="sap-icon://laptop"
                        press="onMyAssets"
                        type="Default"
                        class="quickAccessButton"/>

                    <Button
                        id="maintenanceBtn"
                        text="Maintenance History"
                        icon="sap-icon://wrench"
                        press="onMaintenanceHistory"
                        type="Default"
                        class="quickAccessButton"/>

                </HBox>


                <!-- Details Panel -->
                <Panel
                    id="detailsPanel"
                    headerText="My Profile"
                    class="detailsPanel"
                    expandable="false">

                    <content>

                        <!-- Profile -->
                        <HBox
                            id="profileDetailsRow"
                            wrap="Wrap"
                            class="profileDetailsRow">

                            <VBox
                                id="profileEmployeeField"
                                class="profileField">

                                <Label
                                    id="profileEmployeeLabel"
                                    text="Employee"/>

                                <Text
                                    id="profileEmployeeText"
                                    text="Rahul Sharma"/>

                            </VBox>


                            <VBox
                                id="profileEmailField"
                                class="profileField">

                                <Label
                                    id="profileEmailLabel"
                                    text="Email"/>

                                <Text
                                    id="profileEmailText"
                                    text="rahul.sharma@company.com"/>

                            </VBox>


                            <VBox
                                id="profileDepartmentField"
                                class="profileField">

                                <Label
                                    id="profileDepartmentLabel"
                                    text="Department"/>

                                <Text
                                    id="profileDepartmentText"
                                    text="IT"/>

                            </VBox>


                            <VBox
                                id="profileLocationField"
                                class="profileField">

                                <Label
                                    id="profileLocationLabel"
                                    text="Location"/>

                                <Text
                                    id="profileLocationText"
                                    text="Bangalore"/>

                            </VBox>

                        </HBox>


                        <!-- My Assets -->
                        <List
                            id="assetsDetailsList"
                            visible="false"
                            class="dashboardDetailList"
                            showSeparators="Inner">

                            <StandardListItem
                                id="laptopAssetItem"
                                title="Laptop"
                                description="Assigned IT Laptop"
                                info="1"
                                icon="sap-icon://laptop"/>

                            <StandardListItem
                                id="monitorAssetItem"
                                title="Monitor"
                                description="Assigned External Monitor"
                                info="1"
                                icon="sap-icon://sys-monitor"/>

                            <StandardListItem
                                id="mobileAssetItem"
                                title="Mobile"
                                description="Assigned Company Mobile"
                                info="1"
                                icon="sap-icon://iphone"/>

                        </List>


                        <!-- Maintenance History -->
                        <List
                            id="maintenanceDetailsList"
                            visible="false"
                            class="dashboardDetailList"
                            showSeparators="Inner">

                            <StandardListItem
                                id="laptopMaintenanceItem"
                                title="Laptop Maintenance"
                                description="Battery replacement request"
                                info="Open"
                                icon="sap-icon://wrench"/>

                            <StandardListItem
                                id="monitorMaintenanceItem"
                                title="Monitor Maintenance"
                                description="Display issue resolved"
                                info="Completed"
                                icon="sap-icon://accept"/>

                        </List>

                    </content>

                </Panel>


                <!-- My Overview -->
                <Title
                    id="employeeKpiTitle"
                    text="My Overview"
                    level="H2"
                    class="sectionTitle"/>

                <HBox
                    id="employeeKpiHBox"
                    class="kpiRow"
                    wrap="Wrap"
                    justifyContent="Start">

                    <GenericTile
                        id="tileAssignedAssets"
                        header="My Assets"
                        class="kpiTile">

                        <TileContent
                            id="tcAssignedAssets">

                            <NumericContent
                                id="ncAssignedAssets"
                                value="3"
                                valueColor="Good"
                                icon="sap-icon://laptop"/>

                        </TileContent>

                    </GenericTile>


                    <GenericTile
                        id="tilePendingReturns"
                        header="Pending Returns"
                        class="kpiTile">

                        <TileContent
                            id="tcPendingReturns">

                            <NumericContent
                                id="ncPendingReturns"
                                value="1"
                                valueColor="Critical"
                                icon="sap-icon://undo"/>

                        </TileContent>

                    </GenericTile>


                    <GenericTile
                        id="tileMaintenanceRequests"
                        header="Maintenance Requests"
                        class="kpiTile">

                        <TileContent
                            id="tcMaintenanceRequests">

                            <NumericContent
                                id="ncMaintenanceRequests"
                                value="1"
                                valueColor="Neutral"
                                icon="sap-icon://wrench"/>

                        </TileContent>

                    </GenericTile>

                </HBox>


                <!-- Asset Distribution -->
<Panel
    id="assetDistributionPanel"
    headerText="My Asset Distribution"
    class="chartPanel"
    expandable="false">

    <content>

        <viz:VizFrame
            id="employeeAssetChart"
            vizType="donut"
            width="100%"
            height="360px"/>

    </content>

</Panel>

            </VBox>

        </content>

    </Page>

</mvc:View>