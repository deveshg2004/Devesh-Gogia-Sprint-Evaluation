<mvc:View
    controllerName="asset.lifecycle.reportsui.controller.Reports"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page
        id="reportsPage"
        title="Reports &amp; Export">

        <content>

            <VBox
                id="reportsVBox"
                class="sapUiMediumMargin">

                <ObjectHeader
                    id="reportsHeader"
                    title="Reports &amp; Export Center"
                    intro="Asset Lifecycle Reporting"
                    number="1.0"
                    numberUnit="Version"/>

                <Title
                    id="reportsTitle"
                    text="Available Reports"
                    level="H1"/>

                <List id="reportsList">

                    <StandardListItem
                        id="assetReport"
                        title="Asset Report"
                        description="View asset inventory"
                        type="Navigation"
                        press=".onAssetReport"/>

                    <StandardListItem
                        id="employeeReport"
                        title="Employee Report"
                        description="View employee details"
                        type="Navigation"
                        press=".onEmployeeReport"/>

                    <StandardListItem
                        id="maintenanceReport"
                        title="Maintenance Report"
                        description="View maintenance records"
                        type="Navigation"
                        press=".onMaintenanceReport"/>

                    <StandardListItem
                        id="assignmentReport"
                        title="Assignment Report"
                        description="View asset assignments"
                        type="Navigation"
                        press=".onAssignmentReport"/>

                </List>

                <Title
                    id="exportTitle"
                    text="Download PDF Reports"
                    level="H2"
                    class="sapUiMediumMarginTop"/>

                <Text
                    id="pdfDescription"
                    text="Generate and download a PDF snapshot of each report."
                    class="sapUiSmallMarginBottom"/>

                <VBox id="exportButtons">

                    <Button
                        id="btnExportAssets"
                        text="Download Asset Report PDF"
                        type="Emphasized"
                        press=".onExportAssets"/>

                    <Button
                        id="btnExportEmployees"
                        text="Download Employee Report PDF"
                        class="sapUiSmallMarginTop"
                        press=".onExportEmployees"/>

                    <Button
                        id="btnExportMaintenance"
                        text="Download Maintenance Report PDF"
                        class="sapUiSmallMarginTop"
                        press=".onExportMaintenance"/>

                    <Button
                        id="btnExportAssignments"
                        text="Download Assignment Report PDF"
                        class="sapUiSmallMarginTop"
                        press=".onExportAssignments"/>

                </VBox>

            </VBox>

        </content>

    </Page>

</mvc:View>
