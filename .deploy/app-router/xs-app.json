{
  "welcomeFile": "/index.html",
  "authenticationMethod": "route",
  "logout": {
    "logoutEndpoint": "/do/logout",
    "logoutPage": "/"
  },
  "routes": [
    {
      "source": "^/asset\\.lifecycle\\.vendorui/(.*)$",
      "target": "/asset.lifecycle.vendorui/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "scope": [
        "$XSAPPNAME.Admin"
      ],
      "csrfProtection": false
    },
    {
      "source": "^/(.*)$",
      "target": "$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": true
    }
  ]
}
